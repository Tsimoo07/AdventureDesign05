# Enable only to preview example data.
VITE_USE_DEMO=false
# Set VITE_USE_DEMO=false to read a live API (GET /categories, GET /categories/:id).
VITE_API_URL=
# Kakao public JavaScript key (never use a REST/Admin secret here).
# Register the preview/production domain in Kakao Developers first.
VITE_KAKAO_MAP_KEY=
# Server only: set in .env.local or Vercel environment variables.
KAKAO_REST_API_KEY=
VITE_NAVER_MAP_CLIENT_ID=

# Server only: latest ESP32 reading for hall 2.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# RSSI strictly above this dBm value goes to zones 1/2. The rest goes to A/B.
HALL2_RSSI_SPLIT_DBM=-70
# Minimum average BLE reports per 5 seconds for each congestion level.
HALL2_MODERATE_MIN=500
HALL2_BUSY_MIN=1000
