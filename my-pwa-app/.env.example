# Default: Figma demonstration data, available without a backend.
VITE_USE_DEMO=true
# Set VITE_USE_DEMO=false to read a live API (GET /categories, GET /categories/:id).
VITE_API_URL=http://localhost:3000
# Kakao public JavaScript key (never use a REST/Admin secret here).
# Register the preview/production domain in Kakao Developers first.
VITE_KAKAO_MAP_KEY=
